# Polymarket AI Bitcoin Terminal - Environment Variables
# Copy this file to .env and fill in your keys

# For OpenAI version (poly_ui.py) - REQUIRED
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# For OpenRouter version (poly_or.py) - REQUIRED for that version
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: Set default event
# DEFAULT_EVENT=37049
